// .groundtruth.jsonc — hand-authored assertions extracted from your
// CLAUDE.md / AGENTS.md. Copy this file to .groundtruth.jsonc at your repo
// root and edit it. (LLM-based extraction straight from CLAUDE.md is not
// implemented yet — see the README's roadmap. For now, you write the
// assertions yourself; the format below is exactly what extraction will
// produce later, so nothing here becomes throwaway.)
//
// Every entry has:
//   claim   — the sentence from your context file, verbatim, for humans
//   kind    — one of the 8 supported assertion kinds (README has the full list)
//   args    — kind-specific arguments (see README for each kind's shape)
//   source  — "<file>#L<line>" so a failure traces back to the exact sentence
//             (for eviction assertions: the decision record that retired the
//             fact — absence has no claiming sentence to point at)
//
// These examples are drawn directly from a real audit of a production repo
// (AgendaProfe) that found exactly these four kinds of drift: a decommissioned
// vendor's env vars still declared in build tooling, a leftover MCP server
// config, and — as a sanity check that this file isn't just a list of
// failures — two claims that were still true and should report as passing.
{
  "assertions": [
    // --- "Do NOT reintroduce a Supabase/Vercel env var" (one entry per var —
    // extraction will atomize a claim like this into one checkable fact per
    // named thing, not one assertion trying to cover five vars at once) ---
    {
      "claim": "Do NOT reintroduce a Supabase/Vercel code path or env var.",
      "kind": "env_var_absent",
      "args": { "name": "SUPABASE_URL" },
      "source": "CLAUDE.md#L7"
    },
    {
      "claim": "Do NOT reintroduce a Supabase/Vercel code path or env var.",
      "kind": "env_var_absent",
      // env_var_absent's default scan targets are turbo.json (globalEnv) and
      // .env.example. Pass `files` to point at your own layout, e.g. a
      // config/env/ directory or a specific workflow file's `env:` block.
      "args": { "name": "VERCEL_ENV", "files": ["turbo.json", ".env.example"] },
      "source": "CLAUDE.md#L7"
    },

    // --- "The Supabase project is torn down" — two granularities. path_absent
    // asserts the whole leftover config file doesn't exist; text_absent
    // asserts nothing mentions Supabase at all, wherever it hides. ---
    {
      "claim": "The Supabase project is torn down; do not add an MCP server for it.",
      "kind": "path_absent",
      "args": { "path": ".mcp.json" },
      "source": "CLAUDE.md#L8"
    },
    {
      "claim": "The Supabase project is torn down; do not add an MCP server for it.",
      // text_absent scans every git-tracked text file by default (binaries,
      // >5 MB files, and this assertions file itself are skipped — the last
      // so this very entry's pattern can't trigger the check). `include` /
      // `exclude` globs or an explicit `files` list narrow the scope.
      "kind": "text_absent",
      "args": { "pattern": "supabase", "caseInsensitive": true, "include": ["**/*.json"] },
      "source": "CLAUDE.md#L8"
    },

    // --- text_present: the claim names where something is configured, so the
    // check targets exactly that one file — "mentioned somewhere" is not an
    // assertion worth writing. ---
    {
      "claim": "atuin is installed by `bootstrap.sh`.",
      "kind": "text_present",
      "args": { "pattern": "atuin", "path": "bootstrap.sh" },
      "source": "CLAUDE.md#L14"
    },

    // --- a redacted eviction: this assertion enforces that a retired fact
    // (here the synthetic literal "the Q3 launch codename is Foxglove")
    // appears nowhere — without the assertion itself restating it. Never
    // hand-author the digest: pipe the fact to `groundtruth digest`, or run
    // `groundtruth evict --redact --write --label <name>` to sweep and
    // append in one step. In a real eviction the fact appears in no comment
    // either, obviously — it is spelled out here only to make the example
    // legible. `label` is required: it is the only handle failure reports
    // get. `source` points at the eviction decision record, not a claiming
    // sentence. ---
    {
      "claim": "The retired Q3 launch codename does not appear anywhere in this repo.",
      "kind": "text_absent",
      "args": {
        "patternDigest": {
          "algo": "sha256",
          "salt": "d41d8cd98f00b204e9800998ecf8427e",
          "digest": "b1b1ef93dfb2cc0a4d04cd9a8f516a7f76be8437853e39e584365ab46972455d",
          "rk": 1245521538,
          "length": 34,
          "normalize": "lower"
        },
        "label": "retired-q3-codename"
      },
      "source": "docs/decisions/D-12.md#L3"
    },

    // --- two claims that are still TRUE, so groundtruth isn't just a list of
    // failures — it also tells you which of your rules are still load-bearing ---
    {
      "claim": "`pnpm verify:push` runs typecheck + unit.",
      "kind": "script_exists",
      "args": { "name": "verify:push" },
      "source": "CLAUDE.md#L9"
    },
    {
      "claim": "`entitlementsFor()` in `src/lib/subscriptions/entitlements.ts` is the single place tier logic is decided.",
      "kind": "symbol_at_path",
      "args": { "symbol": "entitlementsFor", "path": "apps/web/src/lib/subscriptions/entitlements.ts" },
      "source": "CLAUDE.md#L10-11"
    },
    {
      "claim": "`checks.yml` runs on every pull request into `main`.",
      "kind": "workflow_trigger",
      "args": { "workflow": "checks.yml", "trigger": "pull_request", "target": "main" },
      "source": "CLAUDE.md#L12"
    }
  ]
}
