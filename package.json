{
  "name": "groundtruth",
  "version": "0.0.1",
  "description": "Verify CLAUDE.md / AGENTS.md against the actual repo — a compiler and CI gate for agent-context assertions.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://groundtruth.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaystewart-dev/groundtruth.git"
  },
  "bugs": {
    "url": "https://github.com/jaystewart-dev/groundtruth/issues"
  },
  "packageManager": "pnpm@11.13.0",
  "bin": {
    "groundtruth": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    ".groundtruth.jsonc.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
