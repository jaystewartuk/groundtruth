{
  "name": "@groundtruth-sh/cli",
  "version": "0.2.1",
  "description": "Verify CLAUDE.md / AGENTS.md against the actual repo — a compiler and CI gate for agent-context assertions.",
  "type": "module",
  "license": "MIT",
  "author": "Jay Stewart",
  "keywords": [
    "claude-md",
    "agents-md",
    "claude-code",
    "agent-context",
    "documentation-drift",
    "assertions",
    "ci",
    "cli",
    "lint",
    "github-action"
  ],
  "homepage": "https://groundtruth.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaystewart-dev/groundtruth.git"
  },
  "bugs": {
    "url": "https://github.com/jaystewart-dev/groundtruth/issues"
  },
  "packageManager": "pnpm@11.13.0",
  "bin": {
    "groundtruth": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".groundtruth.jsonc.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
